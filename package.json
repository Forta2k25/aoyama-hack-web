{
  "name": "aoyama-hack-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:ai": "vite --host 127.0.0.1 --mode ai-preview",
    "dev:student": "vite --host localhost --port 5178 --strictPort --mode student-preview",
    "build:ai-preview": "tsc && vite build --mode ai-preview",
    "build:student-preview": "tsc && vite build --mode student-preview --outDir dist-student",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "check:ai-boundaries": "node scripts/check-ai-boundaries.mjs",
    "check:ai-live-anonymous": "node scripts/check-ai-live-anonymous.mjs"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@vercel/node": "^5.8.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.2",
    "dompurify": "3.4.17",
    "firebase": "^12.13.0",
    "heic-to": "1.6.6",
    "katex": "0.19.0",
    "marked": "18.1.1"
  }
}
